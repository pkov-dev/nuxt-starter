# https://typicode.github.io/husky/#/?id=yarn-on-windows
. "$(dirname "$0")/common.sh"

# Define reusable error message
RED="$(tput setaf 1 2>/dev/null || true)"
RESET="$(tput sgr0 2>/dev/null || true)"
ERROR_MESSAGE="${RED}\nChecks failed. Please fix the errors and try again.\n${RESET}"

# Run checks
run_check() {
  local command="$1"

  eval "$command" || (echo "$ERROR_MESSAGE" && exit 1)
}

# Use Docker only when explicitly requested
# CHECK_IN_DOCKER=true git push
if [ "${CHECK_IN_DOCKER}" = "true" ]; then
  run_check "docker compose -f compose.check.yml run --rm --build nuxt-check"
else
  run_check "pnpm check"
fi