{
  "name": "nuxt-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nuxi build",
    "dev": "concurrently \"pnpm dev:services\" \"nuxi dev\"",
    "dev:services": "docker compose up",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "typecheck": "nuxi typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docs:check": "node tools/check-docs.ts",
    "check": "pnpm lint && pnpm stylelint && pnpm typecheck && pnpm docs:check",
    "postinstall": "nuxi prepare && husky",
    "icons:generate": "tsx tools/generate-icon-collection.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/image": "^2.2.1",
    "@nuxt/scripts": "2.0.0-beta.16",
    "@nuxtjs/better-auth": "0.3.18",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/core": "^15.1.0",
    "@vueuse/nuxt": "^15.1.0",
    "better-auth": "1.7.28",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "nuxt": "^4.7.0",
    "nuxt-security": "2.7.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "vee-validate": "5.0.0-beta.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify/tools": "^5.0.14",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/devtools": "^4.2.1",
    "@nuxt/hints": "1.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-anti-trojan-source": "^1.1.8",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-security-node": "^1.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "postcss-pxtorem": "^6.1.0",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "tailwindcss": "^4.3.5",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ]
  }
}
